{
  "functions": {
    "api/site.js": {
      "includeFiles": "*.html"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/site?path=%2F" },
    { "src": "/index.html", "dest": "/api/site?path=%2Findex.html" },
    { "src": "/thank-you.html", "dest": "/api/site?path=%2Fthank-you.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/site?path=/$1" }
  ]
}
